# ============================================================
# Vanilla Works | Public Relations Management Bot
# ============================================================

# Required: Bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Required: Application Client ID (same as Application ID)
CLIENT_ID=your_application_client_id

# Recommended for development: Guild ID so commands appear instantly
# Leave empty to register global commands (can take up to 1 hour)
GUILD_ID=your_guild_id_for_dev_commands

# Optional: Custom database path (defaults to ./data/bot.db)
# DATABASE_PATH=./data/bot.db
